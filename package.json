{
  "name": "roleflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:all": "concurrently \"npm run dev\" \"npm run bot\"",
    "build": "npx tsx scripts/prepare-prod.ts && prisma generate && npx tsx scripts/sync-policies.ts && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3000",
    "bot": "tsx scripts/bot-daemon.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test src/lib/*.test.ts",
    "discord:register": "tsx scripts/register-discord-commands.ts",
    "review:communities": "tsx scripts/review-communities.ts",
    "security:encrypt-tokens": "tsx scripts/encrypt-bot-tokens.ts",
    "policies:sync": "tsx scripts/sync-policies.ts",
    "policy:notice": "python3 scripts/send_policy_update_email.py"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.35.0",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
