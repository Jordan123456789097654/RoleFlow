generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id // Discord User ID
  username             String
  discriminator        String?
  avatar               String?
  email                String?       // Discord verified email or registered email
  companyEmail             String?    // Verified company email (site admins)
  pendingCompanyEmail      String?
  companyEmailVerifiedAt   DateTime?
  companyEmailCodeHash     String?
  companyEmailCodeExpiresAt DateTime?
  companyEmailAttempts     Int        @default(0)
  passwordHash         String?       // Hashed password for email/password authentication
  emailNotifications   Boolean       @default(true) // User preference for receiving status emails
  robloxId             String?       // Linked Roblox User ID
  robloxUsername       String?
  robloxAvatar         String?
  isSiteAdmin          Boolean       @default(false)
  isSupportStaff       Boolean       @default(false) // Verified RoleFlow Customer Support Staff
  siteRole             String?       @default("USER") // FOUNDER, ADMIN, MODERATOR, SUPPORT, STAFF, USER
  isBanned             Boolean       @default(false) // Globally blacklisted/banned user
  plan                 String        @default("FREE") // FREE, PRO, LIFETIME
  planExpiresAt        DateTime?     // null = no expiry (LIFETIME or never set)
  licenseKey           String?
  supportCode          String?       // 10-minute temporary support login code
  supportCodeExpiresAt DateTime?     // Expiration timestamp
  applications         Application[]
  reviews              Review[]
  communityReviews     CommunityReview[]
  resetTokens          PasswordResetToken[]
  createdAt            DateTime      @default(now())
  sessionVersion       Int           @default(0) // Bumped to revoke all sessions
  totpSecret           String?       // TOTP secret (base32), required for site admins
  totpEnabled          Boolean       @default(false)
  totpRecoveryCodes    String?       // JSON array of bcrypt-hashed one-time recovery codes
  loginDevices         LoginDevice[]
  emailRemovedAt       DateTime?     // Set when the user removes their email; blocks re-sync from Discord on sign-in
  savedProfile         String?       // JSON of answers the user chose to remember
  discordLinked        Boolean       @default(true)
  rosterGroupsOwned    RosterGroup[]
  rosterMemberships    RosterMembership[]
  rosterActionsLogged  RosterAction[]
  rosterAuditEntries   RosterAuditEntry[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Guild {
  id                         String           @id // Discord Guild ID
  name                       String
  icon                       String?
  banner                     String?
  description                String?
  vanitySlug                 String?          @unique // e.g. "meridian", "lucid"
  ownerId                    String
  isVerified                 Boolean          @default(false)
  verifiedBadge              String?          // Single primary badge legacy fallback
  verifiedBadges             String?          // Multiple badges comma-separated: "OFFICIAL,PARTNER,TOP_STUDIO,VERIFIED"
  isPaused                   Boolean          @default(false) // Founder or owner paused community
  memberCount                Int              @default(0)
  tags                       String?          // Comma-separated: "Roblox,Studio,Development"
  category                   String?          // e.g. "Roblox Studios", "Emergency Services", "Tech & Dev", "Gaming Clans", "Creator Networks"
  
  // Premium License & Plan
  plan                       String           @default("FREE") // FREE, PRO, ENTERPRISE, LIFETIME
  planExpiresAt              DateTime?        // null = no expiry
  licenseKey                 String?
  licenseExpiresAt           DateTime?

  // Custom Bot White-label Configuration
  // Custom domain (community's own address for its portal)
  customDomain               String?          @unique // e.g. apply.yourstudio.com
  customDomainToken          String?          // Random token the owner publishes in a DNS TXT record
  customDomainVerified       Boolean          @default(false)
  customDomainVerifiedAt     DateTime?
  partnershipApplications    PartnershipApplication[]
  botOutbox                  BotOutbox[]
  botLiveStatus              String?          // ONLINE | OFFLINE | ERROR, written by the bot daemon
  botLiveStatusAt            DateTime?        // last heartbeat from the daemon
  botLiveMessage             String?
  botLogs                    BotLog[]
  useCustomBot               Boolean          @default(false)
  customBotToken             String?          // AES-256-GCM encrypted (enc:v1:...). Never returned by the API.
  
  // Discord Channels, Webhooks & Roles
  logChannelId               String?          // Staff review alert channel
  webhookUrl                 String?          // Discord Webhook for instant dispatch logs
  reviewerRoleId             String?          // Role allowed to review
  staffPingRoleId            String?          // Role pinged when new application arrives
  embedColor                 String?          @default("#8B5CF6") // Custom embed color
  interviewCatId             String?          // Category for interview threads/channels

  // Portal Customization & Themes
  applicationsOpen   Boolean @default(true)
  announcement       String?  // Short notice shown on the community page
  autoArchiveDays    Int      @default(0) // Archive decided applications after N days (0 = never)
  robloxRequiredAssetId String? // Asset or Game Pass the applicant must own
  interviewVoice     Boolean  @default(false) // Also create a private voice channel for interviews
  customBotAppId     String?  @unique // Discord application ID of the community's own bot (one community per app)
  customBotPublicKey String?  // Discord public key of that bot, for interaction signatures
  showApplicantCount Boolean @default(true)
  welcomeMessage     String?
  websiteUrl         String?
  discordInviteUrl   String?
  portalLayout String @default("banner") // banner | minimal | cards
  portalTheme                String?          @default("obsidian") // obsidian, cyberpunk, emerald, royal, crimson
  portalAccentColor          String?          @default("#8B5CF6")
  siteConfig                 Json?            // Custom-domain look: header style, button label, footer note, reviews toggle (see src/lib/site-config.ts)
  discordWidgetEnabled       Boolean          @default(false)
  
  // Gating & Policy Rules
  cooldownDays               Int              @default(7) // Days after rejection before re-applying
  requireInGuild             Boolean          @default(true)
  minAccountAgeDays          Int              @default(0)
  enableRobloxAuth           Boolean          @default(false)
  
  // Feature 2: Roblox Group Verification
  enableRobloxGroupCheck     Boolean          @default(false)
  robloxGroupId              String?
  robloxMinRank              Int              @default(1)
  robloxMinAccountAgeDays    Int              @default(0)
  robloxCloudApiKey          String?          // Encrypted Roblox Open Cloud API key
  robloxAcceptRankId         Int?             // Target role rank number (1-255) to promote accepted applicants to in the group
  robloxRequiredBadgeId      String?          // Optional required Roblox badge ID
  
  // Feature 3: Multi-Reviewer Blind Voting
  enableBlindVoting          Boolean          @default(false)
  votePassThreshold          Int              @default(2)
  enableInterviewAutoChannel Boolean          @default(true)
  
  positions                  Position[]
  blacklists                 Blacklist[]
  cannedResponses            CannedResponse[]
  staffTeam                  GuildStaff[]
  reviews                    CommunityReview[]
  createdAt                  DateTime         @default(now())
}

model Position {
  id               String        @id @default(cuid())
  guildId          String
  guild            Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title            String
  department       String?       // e.g. "Development", "Staff & Moderation", "Design"
  description      String
  isPublic         Boolean       @default(true)
  acceptRoleId     String?       // Discord role ID granted upon acceptance (#1)
  isOpen           Boolean       @default(true)
  opensAt          DateTime?     // Scheduled opening (null = open immediately)
  closesAt         DateTime?     // Scheduled closing (null = no deadline)
  maxApplications  Int?          // Application cap (null = unlimited)
  waitlistEnabled  Boolean       @default(false) // Accept applications past the cap as waitlisted
  timeLimitMinutes Int?          // Optional timed quiz/test countdown duration in minutes
  richMediaLinks   Boolean       @default(true) // enables media/portfolio auto-preview on external links
  questions        Question[]
  applications     Application[]
  createdAt        DateTime      @default(now())
  deadlineReminderSentAt DateTime? // Set once the closing-soon reminder has gone out
}

model Question {
  id                  String   @id @default(cuid())
  positionId          String
  position            Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  label               String
  description         String?
  type                String   // TEXT, PARAGRAPH, SELECT, CHECKBOX, LINK, PORTFOLIO, FILE
  options             String?  // JSON stringified array for SELECT choices
  required            Boolean  @default(true)
  order               Int      @default(0)
  conditionalParentId String?  // ID of parent question this question depends on (#5)
  conditionalValue    String?  // Value of parent question that triggers this question (#5)
  dependsOnQuestionId String?  // ID of the question this depends on
  dependsOnAnswerValue String? // The expected answer value that reveals this question
  answers             Answer[]
}

model Application {
  id                 String               @id @default(cuid())
  positionId         String
  position           Position             @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String               @default("PENDING") // PENDING, UNDER_REVIEW, INTERVIEW, ACCEPTED, REJECTED
  tags               String?              // Comma-separated tags: "High Priority,Former Staff,Pending Check"
  answers            Answer[]
  reviews            Review[]
  messages           ApplicationMessage[]
  interviewChannelId String?
  decisionNote       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  assignedReviewerId String?   // Discord ID of the staff member reviewing this application
  reviewDueAt        DateTime?
  needsSecondOpinion Boolean     @default(false)
  waitlisted         Boolean     @default(false)
  trackingToken      String?     @unique // Public status-link token
  archivedAt         DateTime?
}

model ApplicationMessage {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String      // User ID of staff or applicant
  senderName    String
  senderRole    String      @default("STAFF") // STAFF or APPLICANT
  content       String
  createdAt     DateTime    @default(now())
}

/// Console lines written by the bot daemon and gateway, shown on the dashboard's live console.
model BotLog {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  level     String   @default("info") // info | success | warn | error
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([createdAt])
}

model GuildStaff {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String   // Discord Snowflake ID of staff member
  username    String?
  roleTitle   String   @default("Reviewer") // e.g. "Lead Recruiter", "Staff Reviewer", "Senior Admin"
  permissions String   @default("vote_only") // view_only, vote_only, full_decision, position_editor
  createdAt   DateTime @default(now())

  @@unique([guildId, userId])
}

model FeedbackReport {
  id          String   @id @default(cuid())
  type        String   @default("BUG_REPORT") // BUG_REPORT, FEATURE_SUGGESTION
  title       String
  description String
  severity    String?  @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  category    String?  @default("OTHER") // UI, BOT, APPLICATION, DISCORD, PERFORMANCE, OTHER
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  authorId    String?  // Discord ID
  authorName  String?  // Discord username
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key       String   @id // e.g. "maintenance_mode", "maintenance_message"
  value     String
  updatedAt DateTime @updatedAt
}

model Answer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value         String
}

model Review {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  comment       String
  score         Int?        // 1-5 rating or vote (1: DENY, 5: APPROVE)
  createdAt     DateTime    @default(now())
}

model CommunityReview {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5 stars
  comment   String   // review text up to 500 chars
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model Blacklist {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  targetType  String   // DISCORD_ID or ROBLOX_ID
  targetValue String
  reason      String?
  createdAt   DateTime @default(now())
}

model GlobalBlacklist {
  id          String   @id @default(cuid())
  targetType  String   // DISCORD_ID or ROBLOX_ID
  targetValue String   // Discord ID or Roblox Username
  reason      String?
  createdAt   DateTime @default(now())
}

model Changelog {
  id          String   @id @default(cuid())
  version     String   // e.g. "v1.3.0"
  title       String   // e.g. "Staff Command Center & Blind Review Voting"
  content     String   // Release notes and bullet points
  tag         String   @default("FEATURE") // MAJOR, FEATURE, IMPROVEMENT, HOTFIX
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model CannedResponse {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String   // ACCEPT or REJECT
  createdAt DateTime @default(now())
}

model LicenseKey {
  id             String    @id @default(cuid())
  key            String    @unique // e.g. RF-PRO-9A8B-7C6D-E5F4
  tier           String    @default("PRO") // PRO, ENTERPRISE, LIFETIME
  scope          String    @default("GUILD") // GUILD, USER
  durationDays   Int?      // null = lifetime / permanent, or e.g. 30, 90, 365
  maxUses        Int       @default(1)
  usesCount      Int       @default(0)
  isRevoked      Boolean   @default(false)
  note           String?   // Founder note: "Issued to Jordan Studios"
  expiresAt      DateTime? // Key redemption cutoff
  redeemedBy     String?   // User ID or Guild ID
  redeemedByName String?   // Username or Guild Name for display
  redeemedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model LoginDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   // SHA-256 of the user-agent
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, fingerprint])
}

model SharedTemplate {
  id                  String   @id @default(cuid())
  title               String
  description         String?
  positionTitle       String
  department          String?
  positionDescription String?
  questionsJson       String   // JSON array of { label, type, description, options, required }
  authorGuildId       String
  authorName          String
  importCount         Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([importCount])
}

model Punishment {
  id           String    @id @default(cuid())
  targetType   String    // USER or GUILD
  targetId     String
  action       String    // WARNING, SUSPENSION, BAN (users); PAUSE, BLACKLIST (guilds)
  reason       String
  expiresAt    DateTime?
  issuedById   String
  createdAt    DateTime  @default(now())
  liftedAt     DateTime?
  appealStatus String    @default("NONE") // NONE, PENDING, APPROVED, DENIED
  appealText   String?
  appealedAt   DateTime?
  decisionNote String?

  @@index([targetType, targetId])
  @@index([appealStatus])
}

model ContentReport {
  id           String    @id @default(cuid())
  targetType   String    // GUILD or POSITION
  targetId     String
  reporterId   String
  reason       String
  status       String    @default("OPEN") // OPEN, DISMISSED (denied), ACTIONED (approved)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([targetType, targetId, status])
}

model SystemEvent {
  id        String   @id @default(cuid())
  level     String   // INFO, WARN, ERROR
  source    String   // email, bot, interactions, auth
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SavedPosition {
  id         String   @id @default(cuid())
  userId     String
  positionId String
  createdAt  DateTime @default(now())

  @@unique([userId, positionId])
  @@index([userId])
}

model ApplicationDraft {
  id         String   @id @default(cuid())
  userId     String
  positionId String
  data       String   // JSON { answers, robloxUsername }
  updatedAt  DateTime @updatedAt

  @@unique([userId, positionId])
  @@index([userId])
}

model PartnershipApplication {
  id           String    @id @default(cuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  applicantId  String
  message      String
  website      String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([guildId])
  @@index([status])
}

model BotOutbox {
  id             String    @id @default(cuid())
  guildId        String
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  kind           String    // ALERT | DM
  method         String
  path           String
  payload        Json?
  fallback       Json?     // email to send if a DM can't be delivered
  status         String    @default("PENDING") // PENDING | SENT | FAILED
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([guildId])
}

model PolicyDocument {
  slug         String   @id // privacy, terms, acceptable-use, community-guidelines, cookies
  title        String
  subtitle     String
  updated      String
  sectionsJson String
  updatedById  String
  updatedAt    DateTime @updatedAt
}

model PolicyRevision {
  id           String   @id @default(cuid())
  slug         String
  title        String
  subtitle     String
  updated      String
  sectionsJson String
  editorId     String
  createdAt    DateTime @default(now())

  @@index([slug, createdAt])
}

/// Reports filed by support staff on the website after they handle a ticket in Discord.
/// The website never sees the ticket itself; staff type the ticket reference in.
model SupportReport {
  id              String   @id @default(cuid())
  reportType      String   // template id, e.g. DATA_REMOVAL, TICKET_RESOLUTION
  ticketRef       String?  // ticket reference typed in by staff from the Discord bot
  subjectUsername String?
  subjectUserId   String?
  authorId        String
  authorName      String?
  fieldsJson      String   // answers to the template's questions
  summary         String
  createdAt       DateTime @default(now())

  redactedFields  String?  // JSON list of answer keys that were redacted
  parentReportId  String?  // the report this one follows up on
  reviewStatus    String   @default("PENDING_REVIEW") // PENDING_REVIEW, VERIFIED, REJECTED, NEEDS_CHANGES
  reviewChecklist String?  // JSON array of the checks the reviewer ticked when verifying
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNote      String?
  workflowStatus  String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_ON_USER, RESOLVED, CLOSED (ticket handling)
  updatedAt       DateTime @updatedAt

  @@index([workflowStatus])
  @@index([parentReportId])
  @@index([authorId, createdAt])
  @@index([reportType, createdAt])
  @@index([ticketRef])
  @@index([subjectUserId])
}

/// One row per piece of personal data removed by support or an admin, or recorded after a removal done elsewhere.
model DataRemovalLog {
  id              String   @id @default(cuid())
  subjectUserId   String
  subjectUsername String?
  item            String   // email, companyEmail, robloxLink, savedProfile, applicationDrafts, loginDevices, applicationMessages, account
  method          String   // SUPPORT_MANUAL, ADMIN_MANUAL, RECORDED_ONLY
  reason          String
  ticketRef       String?
  actorId         String
  actorName       String?
  reportId        String?
  createdAt       DateTime @default(now())

  @@index([subjectUserId])
  @@index([createdAt])
}

/// Full history of a report: filed, verified, rejected, and so on.
model SupportReportEvent {
  id        String   @id @default(cuid())
  reportId  String
  actorId   String
  actorName String?
  action    String   // CREATED, VERIFIED, REJECTED, NEEDS_CHANGES
  note      String?
  details   String?  // JSON snapshot relevant to the event
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
}

/// One row per address that was sent a policy update notice. Used so a notice is never sent twice to the same address.
model PolicyNoticeLog {
  noticeId String
  email    String
  userId   String?
  resendId String?
  sentAt   DateTime @default(now())

  @@id([noticeId, email])
}

// Founder bulk email campaigns. Content is rebuilt from templateId + values at send time, so every batch matches the preview.
model BulkCampaign {
  id              String             @id @default(cuid())
  name            String
  templateId      String
  values          String             // JSON of the template field values, validated on create
  status          String             @default("DRAFT") // DRAFT, SENDING, COMPLETE
  totalSent       Int                @default(0)
  totalFailed     Int                @default(0)
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sendLockedUntil DateTime?          // short lease so two clicks cannot send the same batch twice
  sends           BulkCampaignSend[]

  @@index([createdAt])
}

model BulkCampaignSend {
  campaignId String
  campaign   BulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  userId     String?
  resendId   String?
  sentAt     DateTime     @default(now())

  @@id([campaignId, email])
}

// Addresses that opted out of bulk email. Checked before every campaign send. Keyed by lowercase address.
model EmailOptOut {
  email     String   @id
  source    String   // UNSUBSCRIBE_LINK, ONE_CLICK, ADMIN
  createdAt DateTime @default(now())
}

model SiteDoc {
  slug        String   @id // support-handbook | documentation
  title       String
  body        String   // Plain text: "## Heading" starts a section, "- " starts a bullet, other lines are paragraphs
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Editable public documentation shown at /docs. groupsJson holds the full structure (see src/lib/docs-content.ts).
model DocsPage {
  key         String   @id // always "public-docs"
  groupsJson  String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Earlier versions of the public documentation, so a founder can restore one.
model DocsPageRevision {
  id         String   @id @default(cuid())
  groupsJson String
  editorId   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Community polls, created by the founder. Options are fixed; "other" lets people write their own answer.
model Poll {
  id          String       @id @default(cuid())
  question    String
  description String?
  status      String       @default("OPEN") // OPEN | CLOSED
  allowOther  Boolean      @default(false)
  otherLabel  String       @default("Something else")
  closesAt    DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  options     PollOption[]
  votes       PollVote[]

  @@index([status, createdAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  order  Int        @default(0)
  votes  PollVote[]

  @@index([pollId])
}

/// One vote per account per poll. Voters may change their vote until the poll closes.
model PollVote {
  id        String      @id @default(cuid())
  pollId    String
  poll      Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  optionId  String?
  option    PollOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  otherText String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([pollId, userId])
  @@index([optionId])
}

model SiteSubmission {
  id        String   @id @default(cuid())
  kind      String   // contact, idea, notify, newsletter
  email     String
  name      String?
  message   String?
  interest  String?
  createdAt DateTime @default(now())

  @@index([kind, email])
  @@index([createdAt])
}

model CommunityIdea {
  id          String   @id @default(cuid())
  title       String
  description String
  authorName  String?
  authorId    String?
  category    String   @default("GENERAL") // GENERAL, ROBLOX, DISCORD, AUTOMATION
  status      String   @default("UNDER_REVIEW") // UNDER_REVIEW, PLANNED, IN_PROGRESS, SHIPPED
  upvotes     Int      @default(1)
  voterIps    String?  // JSON array of voter IP hashes or IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([upvotes])
}

model ParentBlogPost {
  slug      String   @id
  title     String
  excerpt   String
  content   String   // JSON string array of paragraphs or markdown
  author    String   @default("RoleFlow Team")
  readTime  String   @default("3 min read")
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time "why are you leaving" survey, linked to a goodbye email.
// Deliberately has NO user reference: the account is deleted, so the answer
// cannot be traced back to the person who left.
model DepartureSurvey {
  id          String    @id // random 32-byte token, base64url; this is the link ID in the email
  reason      String?
  comment     String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  @@index([expiresAt])
}


// ==========================================
// Roster by RoleFlow Models (Unreleased)
// ==========================================

model RosterGroup {
  id              String             @id @default(cuid())
  robloxGroupId   String             @unique
  name            String
  description     String?
  iconUrl         String?
  ownerUserId     String
  owner           User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?
  
  memberships     RosterMembership[]
  staffRecords    RosterStaff[]
  teams           RosterTeam[]
  actions         RosterAction[]
  auditEntries    RosterAuditEntry[]
  trainings       RosterTraining[]
  shifts          RosterShift[]
  rankCache       RosterRankCache[]
  notices         RosterNotice[]

  @@index([ownerUserId])
  @@index([robloxGroupId])
}

model RosterMembership {
  id            String      @id @default(cuid())
  groupId       String
  group         RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  robloxUserId  String
  username      String
  role          String      @default("STAFF") // OWNER, MANAGER, MODERATOR, STAFF
  teamIds       String      @default("[]")
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  joinedAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([groupId, robloxUserId])
  @@index([groupId, role])
  @@index([groupId, status])
  @@index([userId])
}

model RosterStaff {
  id                  String      @id @default(cuid())
  groupId             String
  group               RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  robloxUserId        String
  rank                String
  status              String      @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes               String?
  joinedAt            DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  sourceApplicationId String?

  @@unique([groupId, robloxUserId])
  @@index([groupId, status])
  @@index([groupId, rank])
}

model RosterTeam {
  id        String      @id @default(cuid())
  groupId   String
  group     RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())

  @@unique([groupId, name])
  @@index([groupId])
}

model RosterAction {
  id                 String      @id @default(cuid())
  groupId            String
  group              RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetRobloxUserId String
  actorUserId        String
  actor              User        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  type               String
  reason             String
  durationMinutes    Int?
  createdAt          DateTime    @default(now())
  editedAt           DateTime?
  deletedAt          DateTime?

  @@index([groupId, targetRobloxUserId])
  @@index([groupId, actorUserId])
  @@index([groupId, type])
  @@index([groupId, createdAt])
}

model RosterAuditEntry {
  id          String      @id @default(cuid())
  groupId     String
  group       RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  event       String
  detail      String
  createdAt   DateTime    @default(now())

  @@index([groupId, createdAt])
  @@index([groupId, event])
}

model RosterTraining {
  id          String                     @id @default(cuid())
  groupId     String
  group       RosterGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime                   @default(now())
  attendance  RosterTrainingAttendance[]

  @@index([groupId, startsAt])
}

model RosterTrainingAttendance {
  id           String         @id @default(cuid())
  trainingId   String
  training     RosterTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  robloxUserId String
  completed    Boolean        @default(false)
  updatedAt    DateTime       @updatedAt

  @@unique([trainingId, robloxUserId])
  @@index([trainingId])
}

model RosterShift {
  id         String                  @id @default(cuid())
  groupId    String
  group      RosterGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId     String?
  startsAt   DateTime
  endsAt     DateTime
  closedAt   DateTime?
  createdAt  DateTime                @default(now())
  attendance RosterShiftAttendance[]

  @@index([groupId, startsAt])
}

model RosterShiftAttendance {
  id           String      @id @default(cuid())
  shiftId      String
  shift        RosterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  robloxUserId String
  joinedAt     DateTime    @default(now())

  @@unique([shiftId, robloxUserId])
  @@index([shiftId])
}

model RosterRankCache {
  id           String      @id @default(cuid())
  groupId      String
  group        RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  robloxUserId String
  rank         String
  rankId       Int
  fetchedAt    DateTime    @default(now())

  @@unique([groupId, robloxUserId])
  @@index([groupId, fetchedAt])
}

model RosterNotice {
  id          String      @id @default(cuid())
  groupId     String
  group       RosterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorUserId String
  title       String
  content     String      @db.Text
  targetTeamId String?     // null = entire group
  createdAt   DateTime    @default(now())

  @@index([groupId, createdAt])
}

model ModmailThread {
  id            String           @id @default(cuid())
  discordUserId String
  staffThreadId String           @unique
  status        String           @default("OPEN") // OPEN, CLOSED
  closedBy      String?
  createdAt     DateTime         @default(now())
  closedAt      DateTime?
  messages      ModmailMessage[]

  @@index([discordUserId, status])
}

model ModmailMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    ModmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction String        // INBOUND (from member), OUTBOUND (from staff)
  authorId  String
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([threadId])
}

model ModmailBlock {
  id            String   @id @default(cuid())
  discordUserId String   @unique
  blockedBy     String
  reason        String?
  createdAt     DateTime @default(now())
}

model RobloxVerificationSafeword {
  id             String   @id @default(cuid())
  discordUserId  String
  robloxUserId   String
  robloxUsername String
  safeword       String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([discordUserId])
  @@index([expiresAt])
}


