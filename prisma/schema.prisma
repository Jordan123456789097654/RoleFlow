generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id // Discord User ID
  username             String
  discriminator        String?
  avatar               String?
  email                String?       // Discord verified email
  robloxId             String?       // Linked Roblox User ID
  robloxUsername       String?
  robloxAvatar         String?
  isSiteAdmin          Boolean       @default(false)
  isSupportStaff       Boolean       @default(false) // Verified RoFlow Customer Support Staff
  isBanned             Boolean       @default(false) // Globally blacklisted/banned user
  supportCode          String?       // 10-minute temporary support login code
  supportCodeExpiresAt DateTime?     // Expiration timestamp
  applications         Application[]
  reviews              Review[]
  createdAt            DateTime      @default(now())
}

model Guild {
  id                         String           @id // Discord Guild ID
  name                       String
  icon                       String?
  banner                     String?
  description                String?
  vanitySlug                 String?          @unique // e.g. "meridian", "lucid"
  ownerId                    String
  isVerified                 Boolean          @default(false)
  verifiedBadge              String?          // e.g. "PARTNER", "OFFICIAL", "COMMUNITY"
  isPaused                   Boolean          @default(false) // Founder or owner paused community
  memberCount                Int              @default(0)
  tags                       String?          // Comma-separated: "Roblox,Studio,Development"
  
  // Custom Bot White-label Configuration
  useCustomBot               Boolean          @default(false)
  customBotToken             String?          // Custom Discord Bot Token
  
  // Discord Channels & Roles
  logChannelId               String?          // Staff review alert channel
  reviewerRoleId             String?          // Role allowed to review
  staffPingRoleId            String?          // Role pinged when new application arrives
  embedColor                 String?          @default("#8B5CF6") // Custom embed color
  interviewCatId             String?          // Category for interview threads/channels
  
  // Gating & Policy Rules
  cooldownDays               Int              @default(7) // Days after rejection before re-applying
  requireInGuild             Boolean          @default(true)
  minAccountAgeDays          Int              @default(0)
  enableRobloxAuth           Boolean          @default(false)
  
  // Feature 2: Roblox Group Verification
  enableRobloxGroupCheck     Boolean          @default(false)
  robloxGroupId              String?
  robloxMinRank              Int              @default(1)
  
  // Feature 3: Multi-Reviewer Blind Voting
  enableBlindVoting          Boolean          @default(false)
  votePassThreshold          Int              @default(2)
  enableInterviewAutoChannel Boolean          @default(true)
  
  positions                  Position[]
  blacklists                 Blacklist[]
  cannedResponses            CannedResponse[]
  createdAt                  DateTime         @default(now())
}

model Position {
  id           String        @id @default(cuid())
  guildId      String
  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title        String
  department   String?       // e.g. "Development", "Staff & Moderation", "Design"
  description  String
  isPublic     Boolean       @default(true)
  acceptRoleId String?       // Discord role ID granted upon acceptance (#1)
  isOpen       Boolean       @default(true)
  questions    Question[]
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Question {
  id                  String   @id @default(cuid())
  positionId          String
  position            Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  label               String
  description         String?
  type                String   // TEXT, PARAGRAPH, SELECT, CHECKBOX, LINK, PORTFOLIO, FILE
  options             String?  // JSON stringified array for SELECT choices
  required            Boolean  @default(true)
  order               Int      @default(0)
  conditionalParentId String?  // ID of parent question this question depends on (#5)
  conditionalValue    String?  // Value of parent question that triggers this question (#5)
  answers             Answer[]
}

model Application {
  id                 String    @id @default(cuid())
  positionId         String
  position           Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String    @default("PENDING") // PENDING, UNDER_REVIEW, INTERVIEW, ACCEPTED, REJECTED
  answers            Answer[]
  reviews            Review[]
  interviewChannelId String?
  decisionNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Answer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value         String
}

model Review {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  comment       String
  score         Int?        // 1-5 rating or vote (1: DENY, 5: APPROVE)
  createdAt     DateTime    @default(now())
}

model Blacklist {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  targetType  String   // DISCORD_ID or ROBLOX_ID
  targetValue String
  reason      String?
  createdAt   DateTime @default(now())
}

model GlobalBlacklist {
  id          String   @id @default(cuid())
  targetType  String   // DISCORD_ID or ROBLOX_ID
  targetValue String   // Discord ID or Roblox Username
  reason      String?
  createdAt   DateTime @default(now())
}

model Changelog {
  id          String   @id @default(cuid())
  version     String   // e.g. "v1.3.0"
  title       String   // e.g. "Staff Command Center & Blind Review Voting"
  content     String   // Release notes and bullet points
  tag         String   @default("FEATURE") // MAJOR, FEATURE, IMPROVEMENT, HOTFIX
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model CannedResponse {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String   // ACCEPT or REJECT
  createdAt DateTime @default(now())
}
