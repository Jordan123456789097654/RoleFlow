# AppliX Environment Configuration

# Database
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Discord Bot Configuration (Optional for mock/dev mode, required for live Discord connection)
DISCORD_CLIENT_ID="123456789012345678"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_REDIRECT_URI="https://roleflow.site/api/auth/callback"

# Secret Key
APP_SECRET="applix-secret-dev-session-key-2026"

# Site Admin Discord IDs (comma-separated, automatically granted site-wide admin)
SITE_ADMIN_DISCORD_IDS="123456789012345678"

# Better Stack Monitoring & Telemetry (Optional)
# In Better Stack Uptime, monitor: https://roleflow.site/api/health
BETTERSTACK_SOURCE_TOKEN=""

# Discord app public key (Developer Portal > General Information). Verifies /api/discord/interactions.
DISCORD_PUBLIC_KEY=
