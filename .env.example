DATABASE_URL=
APP_SECRET=            # >= 16 chars, signs sessions
ENCRYPTION_KEY=        # >= 16 chars, encrypts community bot tokens (falls back to APP_SECRET)
NEXT_PUBLIC_APP_URL=https://roleflow.site
COOKIE_DOMAIN=.roleflow.site
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=  # optional, defaults to NEXT_PUBLIC_APP_URL/api/auth/callback
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
SITE_ADMIN_DISCORD_IDS=
FOUNDER_DISCORD_IDS=   # optional, falls back to SITE_ADMIN_DISCORD_IDS
RESEND_API_KEY=
TRUSTED_PROXY_HOPS=1   # proxies in front of the app (Vercel/Cloudflare = 1)
UPSTASH_REDIS_REST_URL=    # optional, shared rate limits across instances
UPSTASH_REDIS_REST_TOKEN=
